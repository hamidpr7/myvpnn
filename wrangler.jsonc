{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "myvpnn",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "3055493b-ee80-47ce-9683-491138de07de","database_name": "fastvpnn" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "8b1e85203eb542aaaba8ce5180ddbb7f" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
